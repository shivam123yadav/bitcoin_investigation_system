SERVICE_NAME=bitcoin-intelligence-backend
SERVICE_VERSION=1.0.0
FRONTEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Shared API token protecting state-changing /api/v1 endpoints
# (case creation/deletion, analysis runs and dataset uploads).
#
# Read-only endpoints (dashboard, leads, clusters, patterns, graph, health)
# stay public, so the demo dashboard keeps working without a token.
#
# When this variable is set, those endpoints require the token in either:
#   X-API-Token: <token>
#   Authorization: Bearer <token>
# and answer HTTP 401 when it is missing and HTTP 403 when it is wrong.
#
# When this variable is unset, token protection is disabled (local
# development mode). Set it for any deployed/demo instance and use a long
# random value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`.
# SIH_API_TOKEN=
