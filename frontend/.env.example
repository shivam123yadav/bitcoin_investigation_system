# Leave this as false for the real FastAPI backend.
VITE_USE_MOCK=false

# Optional: Vite proxies /api/* to this backend origin.
# Local development only. Leave this unset in production so the frontend calls
# /api/v1 on the same origin that serves it.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional. Production default; the frontend calls the same-origin /api/v1 path.
# VITE_API_BASE_URL=/api/v1

# Optional shared deployment token. Must match the backend SIH_API_TOKEN when
# the backend enables token protection for state-changing endpoints
# (case create/delete, analysis runs, dataset uploads).
# Leave unset for local development where the backend has no SIH_API_TOKEN.
# VITE_API_TOKEN=
